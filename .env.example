# Copy this file to .env and set both values before the first start.
# The app exits if either value is empty or still a published placeholder.
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_USERNAME=admin
APP_PASSWORD=

# Optional. Set DEMO_MODE=1 on the public demo so its password cannot be changed.
# DEMO_MODE=
# A username of "demo" also refuses browser password reset unless you opt in.
# ALLOW_PASSWORD_RESET=

# Optional mail for a 30-minute password reset link. Leave SMTP_HOST empty to
# keep email reset off and use `python3 app.py reset-password` instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=1
# PASSWORD_RESET_EMAIL=
# PUBLIC_BASE_URL=https://books.example.com
